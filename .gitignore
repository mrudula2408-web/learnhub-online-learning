# ===================================================================
# LearnHub .gitignore
# Excludes dependencies, builds, environment secrets, and IDE files
# ===================================================================

# ---- Node / Frontend ----
node_modules/
dist/
frontend/dist/
frontend/node_modules/
.npm
.eslintcache

# ---- Java / Maven ----
target/
backend/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ---- Environment Secrets & Private Config ----
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
*.env
!.env.example
!frontend/.env.example
backend/src/main/resources/application-local.properties

# ---- IDEs & Editors ----
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/
.nb-gradle/
.nb-javac/
nbproject/

# ---- Logs & Temporary Files ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- OS Generated Files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
