# ===================================================================
# LearnHub .gitignore
# Excludes dependencies, builds, environment secrets, and IDE files
# ===================================================================

# ---- Node / Frontend ----
node_modules/
dist/
frontend/dist/
frontend/node_modules/
.npm
.eslintcache

# ---- Python / Backend ----
backend/.venv/
backend/env/
backend/venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.db
.pytest_cache/
target/
backend/target/
*.jar


# ---- Environment Secrets & Private Config ----
.env
.env.local
.env.*.local
*.env
!.env.example
!frontend/.env.example
!backend/.env.example

# ---- IDEs & Editors ----
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ---- Logs & Temporary Files ----
*.log
logs/
npm-debug.log*
yarn-debug.log*

# ---- OS Generated Files ----
.DS_Store
Thumbs.db
