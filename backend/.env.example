# Database connection string (Supabase PostgreSQL or SQLite)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret key for auth tokens
SECRET_KEY=replace-this-with-a-random-secure-secret-key-32-chars-long

# JWT Token expiration in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app,*
